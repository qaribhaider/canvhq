{
  "name": "frontend",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.1",
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/third-party-licenses.mjs",
    "lint": "oxlint --max-warnings 147",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write --ignore-path ../.gitignore --ignore-path ../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../.gitignore --ignore-path ../.prettierignore .",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:image": "playwright test --config playwright.image.config.ts"
  },
  "dependencies": {
    "@casl/ability": "^7.0.2",
    "@excalidraw/excalidraw": "0.18.0-1118751",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2004",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.3"
  }
}
