{
  "name": "backend",
  "version": "0.1.1",
  "description": "CanvHQ API",
  "author": "Syed Qarib",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write --ignore-path ../.gitignore --ignore-path ../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../.gitignore --ignore-path ../.prettierignore .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint -c oxlint.json --max-warnings 174 .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:integration": "vitest run --config ./vitest.integration.config.ts",
    "test:storage:cloud": "vitest run test/storage-cloud.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@casl/ability": "^7.0.2",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.14",
    "compression": "^1.8.2",
    "helmet": "^8.3.0",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/mau": "^0.2.9",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
